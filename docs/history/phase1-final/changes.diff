+struct PendingFile {
+    path: PathBuf,
+    file: Option<File>,
+    remove_on_drop: bool,
+}
+
+impl PendingFile {
+    fn new(path: PathBuf) -> Result<Self> {
+        let file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(&path)?;
+        Ok(Self {
+            path,
+            file: Some(file),
+            remove_on_drop: true,
+        })
+    }
+
+    fn temporary(vault_path: &Path) -> Result<Self> {
+        let mut path = vault_path.as_os_str().to_os_string();
+        path.push(format!(".tmp-{}", Uuid::new_v4()));
+        Self::new(PathBuf::from(path))
+    }
+
+    fn file_mut(&mut self) -> &mut File {
+        self.file.as_mut().expect("pending file is still open")
+    }
+
+    fn sync_and_close(&mut self) -> Result<()> {
+        self.file_mut().sync_all()?;
+        self.file.take();
+        Ok(())
+    }
+
+    fn keep(&mut self) {
+        self.remove_on_drop = false;
+    }
+}
+
+impl Drop for PendingFile {
+    fn drop(&mut self) {
+        self.file.take();
+        if self.remove_on_drop {
+            let _ = fs::remove_file(&self.path);
+        }
+    }
 }
 

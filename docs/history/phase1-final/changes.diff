--- before/desktop/e2e/native-boundary.ts
+++ after/desktop/e2e/native-boundary.ts
@@ -0,0 +1,49 @@
+import type { Page } from "@playwright/test";
+
+export async function installNativeBoundaryMock(page: Page, theme = "light") {
+  await page.addInitScript(({ theme }) => {
+    localStorage.setItem("akm-theme", theme);
+    const callbacks = new Map<number, (event: unknown) => void>();
+    const listeners = new Map<string, number>();
+    const calls: { command: string; args: Record<string, unknown> }[] = [];
+    let next = 0;
+    let unlocked = true;
+    const key = {
+      id: "test-entry-uuid", title: "OpenAI", username: null, issuer: "OpenAI",
+      project: "demo", environment: "dev", scopes: ["chat"], tags: [],
+      envVar: "OPENAI_API_KEY", resolvedEnvVar: "OPENAI_API_KEY", url: null,
+      notes: null, expiresAt: null, rotationDays: null, createdAt: null,
+      updatedAt: null, expired: false, rotationDueIn: null,
+    };
+    const emitLock = () => {
+      unlocked = false;
+      const listener = listeners.get("vault-locked");
+      if (listener !== undefined) callbacks.get(listener)?.({ event: "vault-locked", id: listener, payload: null });
+    };
+    Object.assign(window, {
+      __akmTest: { calls, emitLock },
+      __TAURI_EVENT_PLUGIN_INTERNALS__: { unregisterListener: () => {} },
+      __TAURI_INTERNALS__: {
+        transformCallback: (callback: (event: unknown) => void) => { callbacks.set(++next, callback); return next; },
+        unregisterCallback: (id: number) => callbacks.delete(id),
+        invoke: async (command: string, args: Record<string, unknown>) => {
+          calls.push({ command, args });
+          switch (command) {
+            case "plugin:event|listen": listeners.set(args.event as string, args.handler as number); return args.handler;
+            case "plugin:event|unlisten": return;
+            case "vault_status": return { path: "C:/fake-test/vault.kdbx", exists: true, unlocked, keyCount: unlocked ? 1 : 0, vaultName: "UI fixture", needsUpgrade: false };
+            case "vault_warnings": return [];
+            case "vault_activity": return;
+            case "vault_lock": emitLock(); return;
+            case "keys_list": return [key];
+            case "backup_info": return { path: "C:/fake-test/vault.kdbx.bak", exists: false, bytes: 0, modified: null };
+            case "env_import_preview": return { token: "preview-token", added: 0, updated: 1, unchanged: 0, changes: [{ name: "OPENAI_API_KEY", title: "OpenAI", action: "update" }] };
+            case "env_import_confirm": return { added: 0, updated: 1 };
+            case "env_export": return "OPENAI_API_KEY=fake-browser-test-value\n";
+            default: throw new Error(`Unexpected test IPC: ${command}`);
+          }
+        },
+      },
+    });
+  }, { theme });
+}
--- before/desktop/e2e/security-ui.spec.ts
+++ after/desktop/e2e/security-ui.spec.ts
@@ -0,0 +1,48 @@
+import { expect, test } from "@playwright/test";
+import { installNativeBoundaryMock } from "./native-boundary";
+
+declare global {
+  interface Window {
+    __akmTest: { calls: { command: string; args: Record<string, unknown> }[]; emitLock: () => void };
+  }
+}
+
+for (const width of [390, 1440]) {
+  for (const theme of ["light", "dark"]) {
+    test(`${width}px ${theme}: export gate, import review, theme switch and native lock`, async ({ page }) => {
+      await page.setViewportSize({ width, height: 1000 });
+      await installNativeBoundaryMock(page, theme);
+      const errors: string[] = [];
+      page.on("pageerror", (error) => errors.push(error.message));
+      await page.goto("/");
+      await expect(page.getByRole("button", { name: "Add key", exact: true })).toBeVisible();
+      const nextTheme = theme === "light" ? "dark" : "light";
+      await page.getByRole("button", { name: `Switch to ${nextTheme} mode` }).click();
+      await expect(page.locator("html")).toHaveAttribute("data-theme", nextTheme);
+      await page.getByRole("button", { name: `Switch to ${theme} mode` }).click();
+      await expect(page.locator("html")).toHaveAttribute("data-theme", theme);
+      await page.getByRole("button", { name: "Settings", exact: true }).click();
+      for (const name of ["Save .env…", "Preview", "Copy to clipboard"]) {
+        await expect(page.getByRole("button", { name, exact: true })).toBeDisabled();
+      }
+      await page.getByLabel("Project", { exact: true }).selectOption("demo");
+      await page.getByLabel("Environment", { exact: true }).selectOption("dev");
+      await expect(page.getByRole("button", { name: "Preview", exact: true })).toBeEnabled();
+      await page.getByRole("button", { name: "Import .env…" }).click();
+      await page.getByLabel("Paste the .env contents").fill("OPENAI_API_KEY=fake-new-key");
+      await page.getByRole("button", { name: "Review import" }).click();
+      await expect(page.getByRole("region", { name: "Import review" })).toContainText("demo / dev");
+      await expect(page.getByRole("region", { name: "Import review" })).toContainText("Replace secret");
+      expect(await page.evaluate(() => window.__akmTest.calls.filter((call) => call.command === "env_import_confirm").length)).toBe(0);
+      await page.getByRole("button", { name: "Confirm import" }).click();
+      await expect(page.getByText("Imported: 0 added, 1 updated.")).toBeVisible();
+      expect(await page.evaluate(() => document.documentElement.scrollWidth <= document.documentElement.clientWidth)).toBe(true);
+      await page.getByRole("button", { name: "Preview", exact: true }).click();
+      await expect(page.getByText("OPENAI_API_KEY=fake-browser-test-value", { exact: true })).toBeVisible();
+      await page.evaluate(() => window.__akmTest.emitLock());
+      await expect(page.getByRole("button", { name: "Unlock vault", exact: true })).toBeVisible();
+      await expect(page.getByText("OPENAI_API_KEY=fake-browser-test-value", { exact: true })).toHaveCount(0);
+      expect(errors).toEqual([]);
+    });
+  }
+}

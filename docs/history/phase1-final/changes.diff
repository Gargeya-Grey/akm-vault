+fn write_database(path: &std::path::Path, db: &keepass::Database, password: &str) {
+    db.save(
+        &mut std::fs::File::create(path).unwrap(),
+        keepass::DatabaseKey::new().with_password(password),
+    )
+    .unwrap();
+}

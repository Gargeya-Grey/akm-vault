+            .copy(Zeroizing::new("fake".into()), Duration::ZERO)
+            .is_err());
+        assert_eq!(data.lock().unwrap().text, "fake");
+        lease.tick(Duration::from_secs(1)).unwrap();
+        assert_eq!(data.lock().unwrap().text, "");
+        assert_eq!(data.lock().unwrap().clears, 1);

+        lease
+            .copy(Zeroizing::new("fake".into()), Duration::ZERO)
+            .unwrap();
+        data.lock().unwrap().sequence += 1;
+        lease.clear().unwrap();
+        assert_eq!(data.lock().unwrap().text, "fake");
+        assert_eq!(data.lock().unwrap().clears, 0);

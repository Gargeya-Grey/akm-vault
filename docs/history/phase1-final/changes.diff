+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ImportReport {
+    pub added: usize,
+    pub updated: usize,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct PreviewReport {
+    #[serde(flatten)]
+    pub preview: ImportPreview,
+    pub token: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct BackupInfo {
+    pub path: String,
+    pub exists: bool,
+    pub bytes: u64,
+    pub modified: Option<DateTime<Utc>>,
+}
+
+#[cfg(test)]
+mod tests {

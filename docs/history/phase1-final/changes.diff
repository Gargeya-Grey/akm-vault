+    if (command === "vault_unlock") {
+      if (native.active) native.onLock?.();
+      native.active = true;
+      return status();
+    }
+    if (command === "vault_lock") { native.active = false; native.onLock?.(); return; }
+    if (command === "vault_warnings") return [];
+    if (command === "vault_activity") return;

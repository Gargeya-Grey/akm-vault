+fn cleanup_clipboard(gate: &mut Gate, due: Option<Duration>) {
+    let result = match due {
+        Some(now) => gate.clipboard.tick(now),
+        None => gate.clipboard.clear(),
+    };
+    match (gate.clipboard.owned_generation(), result) {
+        (Some(lease), Err(error)) => {
+            if gate.cleanup_episode != Some(lease) {
+                gate.cleanup_episode = Some(lease);
+                application_warning(gate, error.message);
+            }
+        }
+        (None, _) => gate.cleanup_episode = None,
+        // A not-due tick returns Ok while retaining the lease. It is not recovery.
+        (Some(_), Ok(())) => {}
+    }
